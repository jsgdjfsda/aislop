# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=smarthome_dev_password

# TimescaleDB Configuration
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=telemetry
TIMESCALE_PASSWORD=telemetry_dev_password
TIMESCALE_DB=telemetry_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=smarthome
RABBITMQ_PASSWORD=smarthome_dev_password

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# Service Ports
DEVICE_REGISTRY_PORT=8081
DATA_INGESTION_PORT=8082
RULES_ENGINE_PORT=8083
ANALYTICS_PORT=8084
NOTIFICATION_PORT=8085
USER_MANAGEMENT_PORT=8086
API_GATEWAY_PORT=8080

# Notification Service Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@smarthome.local

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Environment
NODE_ENV=development
LOG_LEVEL=debug
